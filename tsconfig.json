{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",          // ✅ Node backend
    "moduleResolution": "node",
    "rootDir": "./skypay",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node","jest"],             // only node for app
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true
  },
  "include": [""]
}
